pkgname=caelestia-cli
pkgver=1.1.3.r20261017
pkgrel=1
pkgdesc='Caelestia CLI with Hyprland Lua configuration support'
arch=(any)
url='https://github.com/caelestia-dots/cli'
license=('GPL-3.0-only')
depends=('python' 'python-pillow' 'python-materialyoucolor' 'libnotify' 'swappy' 'grim' 'dart-sass' 'wl-clipboard' 'slurp' 'gpu-screen-recorder' 'dconf' 'cliphist' 'fuzzel' 'git')
makedepends=('python-build' 'python-installer' 'python-hatchling' 'python-hatch-vcs')
options=(!debug)
build() {
 cd '/home/lookfrost/.local/share/frost-hyprland-setup/sources/cli'
 python -m build --wheel --no-isolation
}
package() {
 python -m installer --destdir="$pkgdir" '/home/lookfrost/.local/share/frost-hyprland-setup/sources'/cli/dist/*.whl
 install -Dm644 '/home/lookfrost/.local/share/frost-hyprland-setup/sources/cli/completions/caelestia.fish' "$pkgdir/usr/share/fish/vendor_completions.d/caelestia.fish"
 install -Dm644 '/home/lookfrost/.local/share/frost-hyprland-setup/sources/cli/LICENSE' "$pkgdir/usr/share/licenses/caelestia-cli/LICENSE"
}
