{
  "workbench.colorTheme": "Dark Modern",
  "window.autoDetectColorScheme": true,
  "workbench.preferredDarkColorTheme": "Dark Modern",
  "workbench.preferredLightColorTheme": "Light Modern",
  "workbench.colorCustomizations": {
    "[Default Dark Modern]": {
      "editor.background": "#070505",
      "editor.foreground": "#ffffff",
      "editor.selectionBackground": "#b0000a80",
      "editor.lineHighlightBackground": "#130a06",
      "editorCursor.foreground": "#ff5a1f",
      "focusBorder": "#d8141c",
      "activityBar.background": "#160c08",
      "sideBar.background": "#160c08",
      "titleBar.activeBackground": "#22110b",
      "statusBar.background": "#22110b",
      "tab.activeBackground": "#070505",
      "tab.inactiveBackground": "#130a06"
    }
  },
  "editor.fontFamily": "'JetBrainsMono Nerd Font', 'Symbols Nerd Font', monospace",
  "editor.fontLigatures": true,
  "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font'",
  "terminal.integrated.defaultProfile.linux": "fish"
}
