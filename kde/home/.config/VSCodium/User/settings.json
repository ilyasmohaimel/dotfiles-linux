{
  "workbench.colorTheme": "Dark Modern",
  "window.autoDetectColorScheme": true,
  "workbench.preferredDarkColorTheme": "Dark Modern",
  "workbench.preferredLightColorTheme": "Light Modern",
  "workbench.colorCustomizations": {
    "[Default Dark Modern]": {
      "editor.background": "#1e1e26",
      "editor.foreground": "#ded6e1",
      "editor.selectionBackground": "#7399bb80",
      "editor.lineHighlightBackground": "#242e30",
      "editorCursor.foreground": "#a9b9c8",
      "focusBorder": "#7399bb",
      "activityBar.background": "#2f3233",
      "sideBar.background": "#2f3233",
      "titleBar.activeBackground": "#2f3233",
      "statusBar.background": "#2f3233",
      "tab.activeBackground": "#1e1e26",
      "tab.inactiveBackground": "#242e30"
    }
  },
  "editor.fontFamily": "'JetBrainsMono Nerd Font', 'Symbols Nerd Font', monospace",
  "editor.fontLigatures": true,
  "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font'",
  "terminal.integrated.defaultProfile.linux": "fish"
}
