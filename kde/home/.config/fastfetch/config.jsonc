{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/home/lookfrost/.config/fastfetch/lookfrost.txt",
    "color": {
      "1": "#B0000A",
      "2": "#FF5A1F"
    },
    "padding": { "top": 0, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "#FF5A1F",
      "title": "#FFFFFF"
    }
  },
  "modules": [
    {
      "type": "title",
      "color": { "user": "#FFFFFF", "at": "#FF5A1F", "host": "#FFFFFF" }
    },
    "separator",
    { "type": "os",       "key": "󰖳" },
    { "type": "host",     "key": "󰟀" },
    { "type": "uptime",   "key": "󰅐" },
    { "type": "packages", "key": "󰏗" },
    { "type": "shell",    "key": "󰞷" },
    { "type": "wm",       "key": "󰕮" },
    { "type": "terminal", "key": "󰆍" },
    { "type": "cpu",      "key": "󰻠" },
    { "type": "gpu",      "key": "󰢮", "format": "{name}", "hideErrors": true, "temp": false },
    { "type": "memory",   "key": "󰘚" },
    { "type": "display",  "key": "󰍹" },
    "break",
    { "type": "colors", "paddingLeft": 2, "symbol": "circle" }
  ]
}
