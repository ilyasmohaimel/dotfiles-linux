[Appearance]
AntiAliasFonts=true
BoldIntense=true
ColorScheme=Molten
Font=JetBrainsMono Nerd Font,11,-1,5,50,0,0,0,0,0
UseFontLineChararacters=false

[General]
Command=/usr/bin/fish
Arguments=--login
Name=Molten
Parent=FALLBACK/
TerminalColumns=120
TerminalMargin=15
TerminalRows=34

[Scrolling]
HistoryMode=2
HistorySize=10000
ScrollBarPosition=2

[Terminal Features]
BlinkingCursorEnabled=true
